# Database (Neon Postgres via Vercel Marketplace)
DATABASE_URL=

# Auth (NextAuth v5)
AUTH_SECRET=

# Cloudflare R2 media
R2_BUCKET=
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Email (Resend - contact form)
RESEND_API_KEY=

# Duitku payment gateway (sandbox experiment)
# DUITKU_ENV: sandbox | production
DUITKU_ENV=sandbox
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# Harus URL publik (pakai ngrok saat dev) yang menunjuk ke POST /callback
DUITKU_CALLBACK_URL=
DUITKU_RETURN_URL=

# On-demand cache revalidation (POST /api/revalidate?secret=...&tag=articles)
REVALIDATE_SECRET=



# Portfolio sync from Vercel (admin → Portfolio → "Sync from Vercel")
# Create a token at https://vercel.com/account/tokens (scope: your team).
VERCEL_API_TOKEN=
# Team id (team_xxx). Optional for personal accounts.
VERCEL_TEAM_ID=
# Optional: https://microlink.io API key to lift the free screenshot rate limit.
MICROLINK_API_KEY=
